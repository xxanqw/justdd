/* justdd/gui/style.qss */

QWidget {
    background-color: #1a1a1a;
    color: #e0e0e0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

QMainWindow, QDialog {
    background-color: #121212;
}

/* Base frames shouldn't have borders usually, but we want clear distinct areas if used as cards */
QFrame {
    border: none;
}

/* Tooltips */
QToolTip {
    background-color: #2c2c2c;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 6px;
    font-size: 13px;
}

/* General Buttons */
QPushButton {
    background-color: #2c2c2c;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #383838;
    border-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #4a4a4a;
    border-color: #5c5c5c;
}

QPushButton:disabled {
    background-color: #1e1e1e;
    color: #555555;
    border-color: #2a2a2a;
}

QPushButton:checked {
    background-color: #1e3a29;
    border: 1px solid #4caf50;
    color: #ffffff;
}

/* Specific Action Buttons */
QPushButton#ContinueButton {
    background-color: #1976D2;
    color: white;
    border: none;
}
QPushButton#ContinueButton:hover {
    background-color: #2196F3;
}
QPushButton#ContinueButton:pressed {
    background-color: #1565C0;
}
QPushButton#ContinueButton:disabled {
    background-color: #1e1e1e;
    color: #555555;
    border: 1px solid #2a2a2a;
}

QPushButton#FlashButton {
    background-color: #D32F2F;
    color: white;
    border: none;
}
QPushButton#FlashButton:hover {
    background-color: #F44336;
}
QPushButton#FlashButton:pressed {
    background-color: #C62828;
}
QPushButton#FlashButton:disabled {
    background-color: #1e1e1e;
    color: #555555;
    border: 1px solid #2a2a2a;
}

/* Checkboxes and RadioButtons */
QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #555555;
    background-color: #2c2c2c;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #4caf50;
    border: 1px solid #4caf50;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border: 1px solid #888888;
}

/* Progress Bar */
QProgressBar {
    background-color: #2c2c2c;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    min-height: 20px;
}

QProgressBar::chunk {
    background-color: #4caf50;
    border-radius: 5px;
}

/* List Widgets (like the Drive list) */
QListWidget {
    background-color: #1f1f1f;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    background-color: transparent;
    padding: 10px;
    border-radius: 6px;
    margin-bottom: 2px;
}

QListWidget::item:hover {
    background-color: #2c2c2c;
}

QListWidget::item:selected {
    background-color: #1e3a29;
    border: 1px solid #4caf50;
    color: #ffffff;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #444444;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Log Views */
QTextEdit, QPlainTextEdit {
    background-color: #1f1f1f;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 8px;
    font-family: monospace;
}

/* Message Boxes */
QMessageBox {
    background-color: #1a1a1a;
}
QMessageBox QLabel {
    color: #e0e0e0;
}
